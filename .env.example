# ── MT5 (Bybit CFD / demo) ───────────────────────────────────────────
# Оставьте пустым — подключимся к уже запущенному терминалу с текущим счётом.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# ── Crypto (ccxt) ────────────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ── Предохранители ───────────────────────────────────────────────────
# true  = торгуем только на DEMO, боевой счёт блокируется (по умолчанию)
# false = разрешить боевой счёт. Меняйте ТОЛЬКО после теста на демо.
DEMO_ONLY=true
# Тестнет для крипты (Binance/Bybit sandbox)
CRYPTO_TESTNET=true

# ── MT5 демо (вторая установка) ──────────────────────────
MT5_DEMO_PATH=D:/MT5-Demo/terminal64.exe
MT5_DEMO_LOGIN=
MT5_DEMO_PASSWORD=
MT5_DEMO_SERVER=MetaQuotes-Demo

# ── FRED (ретроспективная проверка новостного фильтра на бэктестах) ──
# Бесплатная регистрация: https://fredaccount.stlouisfed.org/login/secure/
FRED_API_KEY=

# ── Telegram-бот панели ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_IDS=

# ── Anthropic (кнопка "Проверить новости" в панели, /api/narrative) ──
# Ключ с https://console.anthropic.com/ — без него кнопка вернёт ошибку.
ANTHROPIC_API_KEY=
